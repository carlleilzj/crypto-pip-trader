[Unit]
Description=crypto-pip-trader localhost dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=piptrader
Group=piptrader
WorkingDirectory=/opt/crypto-pip-trader
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/crypto-pip-trader/.venv/bin/python scripts/serve_dashboard.py
Restart=always
RestartSec=10
MemoryMax=256M
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
